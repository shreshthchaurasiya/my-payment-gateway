NODE_ENV=production
YOUPI_MODE=production
STANDALONE=true
YOUPI_BIND_HOST=0.0.0.0
BASE_PAYMENT_API_URL=https://gateway.adshree.com
BASE_CHECKOUT_URL=https://gateway.adshree.com
BASE_ADMIN_URL=https://gateway.adshree.com/admin
BASE_HELP_URL=https://gateway.adshree.com/help
BASE_DEMO_STORE_URL=https://gateway.adshree.com/store
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
INITIAL_ADMIN_EMAIL=admin@adshree.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000
LATE_OBSERVATION_WINDOW_MS=1800000
SMS_OBSERVER_POLL_INTERVAL_MS=3000
ANDROID_ENROLLMENT_SECRET=android_pairing_enrollment_secret_key_32_chars
ANDROID_HEARTBEAT_TIMEOUT_MS=180000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000
YOUPI_ALLOW_PRIVATE_WEBHOOKS=true
DEFAULT_APP_NAME=YOUPI PG
DEFAULT_PRIMARY_COLOR=#2563eb
DEFAULT_SUPPORT_EMAIL=support@adshree.com
